# ---------------------------------------------------------------------------
# Global Intelligence backend — environment template.
# Copy to backend/.env and fill secrets. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# Runtime profile
ENV=development

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000,https://intelligence.example.gov

# --- Security ---------------------------------------------------------------
# 32+ byte hex strings, generated with `openssl rand -hex 32`.
SECRET_KEY=
REFRESH_SECRET_KEY=

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=global_user
POSTGRES_PASSWORD=
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=global_intelligence

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# --- LLM providers ----------------------------------------------------------
# Primary local provider (Ollama). REQUIRED for state-grade mode.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_TIMEOUT=120

# Optional second local provider (vLLM, OpenAI-compatible).
# Leave empty to disable.
VLLM_BASE_URL=
VLLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
VLLM_TIMEOUT=120

# External provider — PUBLIC tasks only. Leave empty to disable
# OpenRouter integration entirely (recommended for state-grade
# deployments).
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3-haiku
# Must be set to "true" before the router will even consider
# routing PUBLIC tasks to OpenRouter. Default: false.
ENABLE_OPENROUTER_FALLBACK=false

# State-grade mode: when true (default), the router refuses to serve
# any CONFIDENTIAL+ task if no local provider is reachable. Set to
# false ONLY for non-classified deployments.
STATE_GRADE_MODE=true

# --- MFA / Second factor ----------------------------------------------------
# AES-GCM key used to encrypt MFA TOTP secrets at rest. 32 bytes hex
# (64 chars). REQUIRED when STATE_GRADE_MODE=true.
# Generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=
# HMAC secret used to sign the short-lived MFA challenge token issued
# by /auth/login when the user has 2FA enabled. MUST differ from
# SECRET_KEY and REFRESH_SECRET_KEY. REQUIRED when STATE_GRADE_MODE=true.
# Generate with: openssl rand -hex 32
MFA_CHALLENGE_SECRET=
# TTL of the MFA challenge token (seconds). Default 300 = 5 minutes.
MFA_CHALLENGE_TTL_SECONDS=300
# Number of single-use recovery codes generated at enrollment.
MFA_RECOVERY_CODES_COUNT=10
# Issuer string displayed by authenticator apps.
MFA_ISSUER=Global Intelligence

# --- Report signing (Ed25519) -----------------------------------------------
# Generate a fresh keypair with OpenSSL:
#   openssl genpkey -algorithm Ed25519 -out ed25519_private.pem
#   openssl pkey -in ed25519_private.pem -pubout -out ed25519_public.pem
# Store them on an encrypted volume / HSM-backed file. In production
# never commit them. If the paths are missing AND STATE_GRADE_MODE=true
# the publication endpoint refuses to publish (HTTP 503).
SIGNING_PRIVATE_KEY_PATH=/var/lib/gi/signing/ed25519_private.pem
SIGNING_PUBLIC_KEY_PATH=/var/lib/gi/signing/ed25519_public.pem

# --- OSINT providers --------------------------------------------------------
# NewsAPI.org free-tier key. Leave empty to disable the NewsAPI
# provider entirely. https://newsapi.org/register
NEWSAPI_API_KEY=
# GDELT 2.0 document-level API. The default is the public endpoint.
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
# HTTP timeout (seconds) applied per provider request.
OSINT_HTTP_TIMEOUT=30
# Hard cap on records pulled from any single source.
OSINT_MAX_PER_SOURCE=25
